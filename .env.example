# Copy this file to .env for local dev, and set the same keys in your
# hosting provider's dashboard (Vercel/Netlify) for production.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Real checkout / payment link the "Buy Now" button should open
VITE_CHECKOUT_URL=https://your-payment-provider.com/checkout/codewithkk-notes

# Backend API base URL (used by the API client; the Vite dev proxy also
# forwards /api to this address)
VITE_API_BASE_URL=http://localhost:8080
